# Configure one live LLM API key below to test Live Mode without changing code.
# Copy this file to prototype/.env (gitignored) and set the key you want to use:

# Option 1: Mistral API (default for Live mode)
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-medium-latest

# Option 2: Google Gemini API
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Option 3: OpenAI API
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
